{
  "name": "photosphere_tours",
  "version": "0.1.6",
  "description": "360° walkthroughs on a floor plan with a timeline, stored as a plain JSON file next to the panoramas.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webpack --mode production --config webpack.config.cjs",
    "dev": "webpack --mode development --config webpack.config.cjs",
    "watch": "webpack --mode development --config webpack.config.cjs --watch",
    "test": "vitest run",
    "import-holobuilder": "node tools/holobuilder-import.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weltmaister/photosphere_tours.git"
  },
  "author": "weltmaister",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.3.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "4.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/map-plugin": "^5.15.1",
    "@photo-sphere-viewer/settings-plugin": "^5.15.1"
  },
  "devDependencies": {
    "css-loader": "^7.1.5",
    "style-loader": "^4.0.0",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
